{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "toc": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "string"
              },
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            ],
            "items": false,
            "minItems": 3,
            "maxItems": 3
          },
          "description": "Outline entries as [level, title, page], page 1-based or -1 for none"
        },
        "pages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Each page as Markdown"
        },
        "textless": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "How many pages have no text layer"
        }
      },
      "required": [
        "title",
        "toc",
        "pages",
        "textless"
      ]
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "type": "string"
        }
      },
      "required": [
        "error"
      ]
    }
  ]
}
